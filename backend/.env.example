# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# CORS — frontend URL
ALLOWED_ORIGINS=http://localhost:5173

# Uploads
MAX_FILE_SIZE=5242880

# Email Configuration (Multi-channel failover: Resend -> Formspree -> SMTP)
ADMIN_EMAIL=bhaveshnakum802@gmail.com
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
FORMSPREE_URL=https://formspree.io/f/xrpppyrg
SMTP_USER=your_smtp_email@example.com
SMTP_PASS=your_smtp_app_password

# Emergency Fail-Safe (Zero-Lockout Break-Glass Recovery Code)
# A secret 6-to-12 character code you can use to bypass 2FA OTP if third-party email providers ever fail
EMERGENCY_RECOVERY_CODE=982400

# Owner Admin Default Password (set a strong password)
OWNER_PASSWORD=your_strong_admin_password_here
